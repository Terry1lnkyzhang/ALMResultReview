{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_step", "applicability", "findings", "reference_decisions", "extracted_equipment", "summary"],
        "properties": {
          "review_step": {"type": "integer", "minimum": 1},
          "applicability": {"enum": ["applicable", "not_applicable", "manual"]},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "severity", "reason"],
              "properties": {
                "code": {"enum": ["actual_missing", "actual_insufficient", "expected_actual_mismatch", "language_quality", "evidence_reference_missing"]},
                "severity": {"enum": ["warning", "fail", "manual"]},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          },
          "reference_decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "role", "requires_check", "reason"],
              "properties": {
                "candidate_id": {"type": "string", "minLength": 1},
                "role": {"enum": ["test_equipment", "dut_or_other", "result_evidence", "reference_document", "result_evidence_location", "unrelated", "uncertain"]},
                "requires_check": {"type": "boolean"},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          },
          "extracted_equipment": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["device_name", "equipment_id", "serial_number", "reported_calibration_due_date", "source_text"],
              "properties": {
                "device_name": {"type": "string", "maxLength": 512},
                "equipment_id": {"type": "string", "maxLength": 128},
                "serial_number": {"type": "string", "maxLength": 255},
                "reported_calibration_due_date": {"type": "string", "maxLength": 32},
                "source_text": {"type": "string", "minLength": 1, "maxLength": 512}
              }
            }
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}