{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_step", "role", "required", "selected_equipment_ids", "selected_equipment_names", "reason"],
        "properties": {
          "review_step": {"type": "integer", "minimum": 1},
          "role": {"enum": ["controlled_equipment", "dut_or_other", "uncertain"]},
          "required": {"type": "boolean"},
          "selected_equipment_ids": {"type": "array", "items": {"type": "string"}},
          "selected_equipment_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
