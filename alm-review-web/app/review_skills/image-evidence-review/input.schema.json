{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["alm_run_status", "steps"],
  "properties": {
    "alm_run_status": {
      "enum": ["Passed", "Failed"],
      "description": "Trusted final ALM Run status."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_step", "alm_step_status", "description", "expected", "actual", "images"],
        "properties": {
          "review_step": {"type": "integer", "minimum": 1},
          "alm_step_status": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["media_id", "source_path", "relative_name", "mime_type", "sha256", "width", "height"],
              "properties": {
                "media_id": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "relative_name": {"type": "string", "minLength": 1},
                "mime_type": {"type": "string", "pattern": "^image/"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "width": {"type": ["integer", "null"], "minimum": 1},
                "height": {"type": ["integer", "null"], "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
