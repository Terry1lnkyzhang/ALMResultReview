{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_step", "status", "reason", "observed_media_ids"],
        "properties": {
          "review_step": {"type": "integer", "minimum": 1},
          "status": {"enum": ["pass", "fail", "manual"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "observed_media_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
