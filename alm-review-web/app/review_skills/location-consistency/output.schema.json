{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["has_configuration_claim", "status", "comparisons", "reason"],
  "properties": {
    "has_configuration_claim": {"type": "boolean"},
    "status": {"enum": ["pass", "not_applicable", "fail", "uncertain"]},
    "comparisons": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "parent_text", "status", "reason"],
        "properties": {
          "field": {"enum": ["product", "dms_version", "dms_coverage", "couch", "computer"]},
          "parent_text": {"type": "string", "minLength": 1, "maxLength": 512},
          "status": {"enum": ["matched", "mismatched", "uncertain"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}